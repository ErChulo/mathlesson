{
  "name": "mathlesson",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "safety:guard": "node tools/analysis/verify-safety-policy.mjs",
    "bundle:report": "node tools/analysis/report-renderer-bundles.mjs",
    "check": "npm run typecheck && npm run safety:guard && npm run test && npm run build && npm run bundle:report"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.1.2",
    "katex": "0.16.47",
    "mermaid": "11.16.0",
    "plotly.js-dist-min": "2.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  }
}
